# 1) Environment files
.env
.env.*

# 2) Virtual environments
venv/
.venv/

# 3) Python caches
__pycache__/
*.pyc
*.pyo

# 4) Test, type-check and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
